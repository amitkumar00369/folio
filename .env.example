# inprocess (default, nothing else to run) or celery (needs Redis + a worker)
QUEUE_BACKEND=inprocess
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=sqlite:///./folio.db

# in-process mode only: subscribers handled in parallel per job
REBALANCE_CONCURRENCY=4

# mock broker
BROKER_LATENCY_MS=0
BROKER_FAILURE_RATE=0
BROKER_MAX_ATTEMPTS=3
